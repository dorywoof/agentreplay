{
  "name": "agentreplayer",
  "version": "0.11.5",
  "description": "Turn any AI coding agent session (Claude Code, Codex, Gemini CLI, OpenCode, Cline, Roo, Copilot CLI, Aider, …) into a shareable, video-like HTML replay with cost stats and secret redaction.",
  "homepage": "https://github.com/dorywoof/agentreplayer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dorywoof/agentreplayer.git"
  },
  "bugs": {
    "url": "https://github.com/dorywoof/agentreplayer/issues"
  },
  "type": "module",
  "bin": {
    "agentreplayer": "bin/agentreplayer.js"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/",
    "demo": "node bin/agentreplayer.js examples/demo-session.jsonl -o examples/demo.html --no-open"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude-code",
    "codex",
    "ai-agent",
    "replay",
    "session",
    "transcript",
    "llm",
    "cli",
    "gemini-cli",
    "opencode",
    "cline",
    "roo-code",
    "kilo-code",
    "copilot",
    "qwen-code",
    "amp",
    "aider",
    "chat-log",
    "transcript-viewer",
    "claude-code-plugin",
    "claude-skill"
  ],
  "license": "MIT"
}
